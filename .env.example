# Copy to .env.local (Vite) / export in shell (server & adapters).
# Core demo (`npm run dev`) needs none of these.

# --- Server (npm run server) ---
# PORT=8787
# HOST=127.0.0.1
# DISPATCH_TOKEN=

# --- UI live mode (npm run dev:live) ---
# VITE_FEED_MODE=sse
# VITE_API_BASE=
# VITE_DISPATCH_TOKEN=

# --- Adapters / fake agent ---
# DISPATCH_URL=http://127.0.0.1:8787
# DISPATCH_GATE=0
# DISPATCH_GATE_TIMEOUT_MS=300000
# HERO_ID=sess_generic_demo
